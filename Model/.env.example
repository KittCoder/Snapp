OPENAI_API_KEY=
FDC_API_KEY=

APIFY_API_TOKEN=
APIFY_TRADER_JOES_ACTOR_ID=merry_arctic~trader-joes-scraper
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://snapp-1d5j.vercel.app
SNAPP_ENV=development
SNAPP_LOG_FORMAT=text
SNAPP_LOG_LEVEL=INFO
SNAPP_ADMIN_TOKEN=replace-with-a-random-secret
SNAPP_ALLOW_LEXICAL_ONLY=0
SNAPP_MAX_JSON_PAYLOAD_BYTES=524288
SNAPP_MAX_DISH_PROMPT_CHARS=500
SNAPP_MAX_PANTRY_ITEMS_PER_REQUEST=200

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=snapp_recipes

# Optional local adapter factory: package.module:create_model (blank = deterministic).
# Adapters implement RecipeChatModel and configure their own bounded network timeout.
SNAPP_RECIPE_CHAT_MODEL_FACTORY=

# Reserved for the eventual database integration. Keep the service-role key backend-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Production security (values are examples/placeholders, not credentials)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://snapp-1d5j.vercel.app
SNAPP_RATE_LIMIT_ENABLED=1
SNAPP_RATE_LIMIT_DEFAULT=120 per minute
SNAPP_RATE_LIMIT_COMPUTE=30 per minute
SNAPP_RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
SUPABASE_URL=https://your-project.supabase.co
# Generate SNAPP_ADMIN_TOKEN in the deployment secret manager; never commit it.

# Standard Redis alias; canonical SNAPP_RATE_LIMIT_STORAGE_URI takes precedence.
REDIS_URL=
SUPABASE_ANON_KEY=sb_publishable_replace_me
